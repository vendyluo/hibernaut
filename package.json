{
  "name": "hibernaut",
  "version": "1.0.0",
  "private": true,
  "description": "A Cloudflare long-task agent template: durable acceptance, terminal receipts and replaceable product policies.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "workspaces": [
    "test-workers"
  ],
  "type": "module",
  "scripts": {
    "test": "npm run test:core && npm run test:workers",
    "test:core": "vp test run",
    "test:workers": "npm test --workspace @hibernaut/worker-tests",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "smoke": "node scripts/smoke.mjs",
    "smoke:tasks": "node scripts/smoke-tasks.mjs",
    "build": "wrangler deploy --dry-run",
    "types": "wrangler types --include-runtime=false",
    "check": "vp check src test test-workers scripts/smoke-tasks.mjs vite.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "agents": "0.20.1",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  }
}
