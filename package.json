{
  "name": "hibernaut",
  "version": "1.0.0",
  "private": true,
  "description": "A Cloudflare durable-agent pattern template: explicit state, timeout guards, and recovery.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:workers": "vitest run --project workers",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "smoke": "node scripts/smoke.mjs",
    "build": "wrangler deploy --dry-run",
    "types": "wrangler types --include-runtime=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "agents": "0.20.1",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module"
}
